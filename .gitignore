```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
pip-log.txt
pip-selfcheck.json

# Logs
*.log

# Environment variables
.env
.env.local
.env.*
.env~*
.venv.bak

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build and distribution artifacts
build/
dist/
*.egg-info/

# Testing
.coverage
htmlcov/
.coverage.*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
```