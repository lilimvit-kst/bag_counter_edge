FROM python:3.11-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Set environment for pip
ENV PIP_NO_CACHE_DIR=1
ENV PIP_USER=0

# Copy requirements first (for better caching)
COPY requirements.txt .

# Install dependencies in layers for better caching
RUN pip install --upgrade pip
RUN pip install numpy==1.26.4
RUN pip install torch==2.2.0+cu121 torchvision==0.17.0+cu121 --extra-index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir \
    opencv-python-headless==4.8.1.78 \
    Pillow==10.2.0 \
    python-dotenv==1.0.0 \
    ultralytics==8.2.0 \
    filterpy==1.4.5 \
    scipy==1.12.0 \
    sqlalchemy==2.0.25 \
    alembic==1.13.1 \
    pydantic==2.6.1 \
    pydantic-settings==2.2.1 \
    ffmpeg-python==0.2.0 \
    loguru==0.7.2 \
    orjson==3.9.12 \
    celery==5.3.6 \
    redis==5.0.1 \
    websockets==12.0 \
    python-jose[cryptography]==3.3.0 \
    passlib[bcrypt]==1.7.4 \
    python-multipart==0.0.6 \
    slowapi==0.1.9 \
    pytest==8.0.0 \
    pytest-cov==4.1.0 \
    pytest-asyncio==0.23.3 \
    httpx==0.26.0 \
    prometheus-client==0.19.0

# Install streamlit separately to ensure it's available in PATH
RUN pip install --no-cache-dir streamlit==1.31.0 && which streamlit

# Runtime stage
FROM python:3.11-slim-bookworm AS runtime

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy source code
COPY src/ ./src/
COPY models/ ./models/

# Ensure storage directories exist
RUN mkdir -p storage/clips storage/db storage/nvr storage/logs

# Copy dashboard entrypoint script
COPY entrypoint.dashboard.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Health check for Streamlit dashboard
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import socket; s = socket.socket(); result = s.connect_ex(('127.0.0.1', 8501)); exit(0 if result == 0 else 1)" || exit 1

# Run Streamlit dashboard
ENTRYPOINT ["/entrypoint.sh"]
