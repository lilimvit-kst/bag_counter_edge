# ===========================================
# Bag Counter Edge - Пример файла окружения
# ===========================================
# Скопируйте этот файл в .env и настройте переменные под вашу среду.
# Команда: cp .env.example .env
#
# Все значения по умолчанию безопасны для локальной разработки.
# Для production обязательно измените секьюрити-параметры!

# ===========================================
# Камера / Поток (Camera / Stream)
# ===========================================
# URL основного RTSP потока (RGB камера)
# Замените IP адрес на адрес вашей камеры
PRIMARY_STREAM_URL=rtsp://192.168.1.100:554/stream1

# URL дополнительного RTSP потока (опционально, для depth/stereo камеры)
SECONDARY_STREAM_URL=rtsp://192.168.1.101:554/stream1

# Частота кадров для обработки (FPS)
# Рекомендуемые значения: 15, 25, 30
FPS=25

# ===========================================
# Детекция объектов (Detection)
# ===========================================
# Имя модели YOLO для детекции мешков
# Доступные варианты: yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
# Или путь к своей модели: models/custom_bag_model.pt
DETECTION_MODEL=yolov8n.pt

# Порог уверенности детекции (0.0 - 1.0)
# Значения ниже 0.5 могут давать много ложных срабатываний
CONFIDENCE_THRESHOLD=0.65

# Порог IoU для NMS (Non-Maximum Suppression)
IOU_THRESHOLD=0.45

# ===========================================
# Redis / Celery (Очереди задач)
# ===========================================
# URL подключения к Redis
# Для Docker Compose используйте: redis://redis:6379/0
# Для локального запуска: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Включить обработку фоновых задач через Celery
# true - включить, false - выключить
CELERY_ENABLED=true

# ===========================================
# WebSocket (Real-time обновления)
# ===========================================
# Включить WebSocket сервер для real-time уведомлений
WEBSOCKET_ENABLED=true

# Порт WebSocket сервера
WEBSOCKET_PORT=8765

# ===========================================
# Безопасность API (API Security)
# ===========================================
# СЕКРЕТНЫЙ КЛЮЧ для JWT токенов
# ОБЯЗАТЕЛЬНО измените в production на случайную строку!
# Генерация: openssl rand -hex 32
API_SECRET_KEY=change-me-in-production

# Время жизни JWT токена в минутах
API_TOKEN_EXPIRE_MINUTES=30

# Лимит запросов к API в минуту (rate limiting)
API_RATE_LIMIT_PER_MINUTE=60

# Учетные данные администратора по умолчанию
# ОБЯЗАТЕЛЬНО измените в production!
API_ADMIN_USER=admin
API_ADMIN_PASS=admin

# ===========================================
# Уведомления (Notifications)
# ===========================================
# SMTP настройки для email уведомлений
# Оставьте пустыми, если email уведомления не нужны
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=manager@example.com

# Telegram настройки для уведомлений
# Получите токен у @BotFather, chat_id у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Включить уведомления при закрытии вагона
NOTIFY_ON_WAGON_CLOSE=true

# Включить уведомления при низком остатке мешков
NOTIFY_ON_LOW_STOCK=false

# Порог низкого остатка (количество мешков)
LOW_STOCK_THRESHOLD=100

# ===========================================
# Логирование (Logging)
# ===========================================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Формат логов: json или text
# json рекомендуется для production (совместимость с ELK/Loki)
LOG_FORMAT=text

# ===========================================
# NVR / Клипы (Запись видео)
# ===========================================
# Количество дней хранения записей NVR
NVR_RETENTION_DAYS=7

# Длительность сегмента записи в минутах
NVR_SEGMENT_MINUTES=10

# Длительность предзаписи перед событием (секунды)
CLIP_PREROLL_SEC=2.0

# Длительность постзаписи после события (секунды)
CLIP_POSTROLL_SEC=3.0

# ===========================================
# Смены / Вагоны (Shift / Wagon)
# ===========================================
# Длительность смены в часах
SHIFT_DURATION_HOURS=12.0

# ===========================================
# GPU / CUDA (Опционально)
# ===========================================
# Использовать GPU для инференса (true/false)
# Требуется установка CUDA и cudnn
USE_CUDA=true

# Индекс GPU устройства (для систем с несколькими GPU)
CUDA_DEVICE=0
