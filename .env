# ==========================================
# BAG COUNTER EDGE - Конфигурационный файл
# ==========================================
# Скопируйте этот файл в .env и заполните значениями для вашей среды.
# Команда: cp .env.example .env

# ------------------------------------------
# 1. ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ------------------------------------------
# Режим работы: production или development
ENVIRONMENT=production

# Уровень отладки (true/false)
DEBUG=false

# Хост и порт API сервера
# Для локальной разработки: HOST=0.0.0.0 (слушать все интерфейсы)
# Для production: HOST=0.0.0.0 (для доступа из сети)
# Для Docker mode: HOST=0.0.0.0 (обязательно для доступа из контейнеров)
HOST=0.0.0.0
API_PORT=8000

# Секретный ключ для подписи JWT токенов и сессий
# ВАЖНО: Замените на случайную строку в production!
API_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Разрешенные CORS_origins (список JSON)
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------
# 2. БАЗА ДАННЫХ
# ------------------------------------------
# URL подключения к базе данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./storage/bag_counter.db

# ------------------------------------------
# 3. REDIS И CELERY (ОЧЕРЕДИ ЗАДАЧ)
# ------------------------------------------
# URL Redis сервера
REDIS_URL=redis://redis:6379/0

# URL брокера сообщений для Celery
CELERY_BROKER_URL=redis://redis:6379/0

# URL бэкенда результатов для Celery
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------
# 4. КАМЕРА И ВИДЕОПОТОК (НАСТРАИВАЕТСЯ БЕЗ ПЕРЕСБОРКИ!)
# ------------------------------------------
# Источник видео: RTSP URL или индекс устройства (0 для USB)
# Пример RTSP: rtsp://admin:password@192.168.1.100:554/stream1
# ИЗМЕНИТЕ ЭТО ЗНАЧЕНИЕ для подключения вашей камеры
CAMERA_SOURCE=rtsp://admin:password@192.168.1.100:554/stream1

# Дополнительный поток (опционально для глубины/стерео)
SECONDARY_STREAM_URL=

# FPS камеры
CAMERA_FPS=30

# Разрешение видео (опционально, если камера поддерживает)
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# ------------------------------------------
# 5. ML МОДЕЛЬ И ДЕТЕКЦИЯ (YOLO)
# ------------------------------------------
# Путь к файлу модели YOLO (yolov8n.pt, yolov8s.pt, etc.)
YOLO_MODEL_PATH=models/yolov8n.pt

# Порог уверенности детекции (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# Порог IoU (Intersection over Union) для NMS
IOU_THRESHOLD=0.45

# Классы объектов для детекции (IDs через запятую, если нужно фильтровать)
# Оставьте пустым для всех классов COCO
DETECT_CLASSES=

# ------------------------------------------
# 6. НАСТРОЙКИ CV PIPELINE (БЕЗ ПЕРЕСБОРКИ!)
# ------------------------------------------
# Положение виртуальной линии (tripwire) - доля высоты кадра (0.0-1.0)
TRIPWIRE_Y_RATIO=0.75

# Количество кадров исчезновения перед фиксацией "передачи" мешка
HANDOVER_DISAPPEAR_FRAMES=10

# Region of Interest (ROI) для трекинга - доли ширины/высоты кадра
ROI_X1_RATIO=0.1
ROI_X2_RATIO=0.9
ROI_Y1_RATIO=0.2
ROI_Y2_RATIO=0.9

# ------------------------------------------
# 7. NVR И ЗАПИСЬ КЛИПОВ
# ------------------------------------------
# Длительность клипа до события (секунды)
NVR_PRE_EVENT_DURATION=5

# Длительность клипа после события (секунды)
NVR_POST_EVENT_DURATION=10

# Длительность сегмента непрерывной записи (минуты)
NVR_SEGMENT_MINUTES=10

# Срок хранения записей (дни)
NVR_RETENTION_DAYS=7

# ------------------------------------------
# 8. АУТЕНТИФИКАЦИЯ И БЕЗОПАСНОСТЬ
# ------------------------------------------
# Логин администратора по умолчанию
ADMIN_USERNAME=admin

# Пароль администратора по умолчанию
# ВАЖНО: Смените сразу после первого входа!
ADMIN_PASSWORD=changeme

# Время жизни JWT токена доступа (минуты)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Время жизни JWT токена обновления (дни)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Лимит запросов в минуту на один IP (Rate Limiting)
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------
# 9. УВЕДОМЛЕНИЯ (EMAIL)
# ------------------------------------------
# Включить уведомления по Email (true/false)
ENABLE_EMAIL_NOTIFICATIONS=false

# SMTP сервер
SMTP_SERVER=smtp.example.com

# SMTP порт (587 для TLS, 465 для SSL)
SMTP_PORT=587

# Пользователь SMTP
SMTP_USER=user@example.com

# Пароль SMTP
SMTP_PASSWORD=password

# Email получателя уведомлений
NOTIFICATION_EMAIL=admin@example.com

# Использовать TLS для SMTP (true/false)
SMTP_USE_TLS=true

# ------------------------------------------
# 10. УВЕДОМЛЕНИЯ (TELEGRAM)
# ------------------------------------------
# Включить уведомления в Telegram (true/false)
ENABLE_TELEGRAM_NOTIFICATIONS=false

# Токен бота Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token

# Chat ID для отправки сообщений (можно узнать у @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id

# ------------------------------------------
# 11. ЛИМИТЫ И ПРОИЗВОДИТЕЛЬНОСТЬ
# ------------------------------------------
# Максимальное количество одновременных потоков
MAX_CONCURRENT_STREAMS=4

# ------------------------------------------
# 12. СМЕНЫ И ВАГОНЫ (БИЗНЕС-ЛОГИКА)
# ------------------------------------------
# Длительность смены в часах
SHIFT_DURATION_HOURS=12

# ------------------------------------------
# 13. GPU И УСКОРЕНИЕ (ОПЦИОНАЛЬНО)
# ------------------------------------------
# Использовать CUDA (true/false, если есть NVIDIA GPU)
USE_CUDA=false

# Индекс устройства CUDA (0 для первой карты)
CUDA_DEVICE=0

# ------------------------------------------
# 14. ЛОГИРОВАНИЕ
# ------------------------------------------
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------
# 15. РОЛЬ ИНСТАНСА (ДЛЯ МИКРОСЕРВИСОВ)
# ------------------------------------------
# Роль текущего инстанса: master, worker или standalone
# standalone - запускает всё в одном процессе (по умолчанию)
INSTANCE_ROLE=standalone

# ------------------------------------------
# 16. WEBSOCKET
# ------------------------------------------
# Включить WebSocket (true/false)
WEBSOCKET_ENABLED=true

# Порт WebSocket сервера
WEBSOCKET_PORT=8765

# ------------------------------------------
# 17. CELERY
# ------------------------------------------
# Включить Celery для фоновых задач (true/false)
CELERY_ENABLED=true

# ------------------------------------------
# 18. НАСТРОЙКИ DASHBOARD (KIOSK)
# ------------------------------------------
# Режим запуска: docker, local, network
# - docker: Dashboard в контейнере, API по внутреннему имени сервиса (рекомендуется для Docker Compose)
# - local: Dashboard и API на localhost
# - network: Dashboard и API доступны по IP в сети (рекомендуется для доступа из внешней сети)
RUN_MODE=docker

# Хост API для подключения из браузера (приоритетная переменная)
# Для RUN_MODE=docker: оставьте пустым (используется INTERNAL_API_HOST для внутренних запросов)
# Для RUN_MODE=local: localhost
# Для RUN_MODE=network: IP адрес сервера (например, 192.168.1.100 или 10.10.10.235)
# ВАЖНО: Укажите IP-адрес сервера, на котором запущен Docker, чтобы подключаться из вашей сети
# DASHBOARD_API_HOST=

# Порт API для подключения из браузера
# Должен совпадать с портом, опубликованным в docker-compose.yml для сервиса edge-cv
# DASHBOARD_API_PORT=

# Внутренний хост API для связи между контейнерами (Docker-сеть)
# Для RUN_MODE=docker: edge-cv (имя сервиса в Docker Compose)
# Для RUN_MODE=local: localhost
# Для RUN_MODE=network: IP адрес сервера
INTERNAL_API_HOST=edge-cv

# Хост API сервиса (внешняя переменная, используется только для network/local режимов)
# Для RUN_MODE=docker: не используется (берется INTERNAL_API_HOST)
# Для RUN_MODE=local: localhost
# Для RUN_MODE=network: IP адрес сервера
API_HOST=0.0.0.0

# Порт API сервиса (должен совпадать с API_PORT в edge-cv)
API_PORT=8000
