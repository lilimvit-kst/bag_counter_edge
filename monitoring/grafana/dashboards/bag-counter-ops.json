{
  "dashboard": {
    "id": null,
    "uid": "bag-counter-ops",
    "title": "Bag Counter Edge - Operations Dashboard",
    "tags": ["bag-counter", "operations", "production"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "type": "stat",
        "title": "Total Bags Counted",
        "targets": [
          {
            "expr": "sum(bag_counter_bags_total)",
            "legendFormat": "Total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "blue", "value": 100},
                {"color": "purple", "value": 500}
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center",
          "textMode": "auto"
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "type": "stat",
        "title": "Est. Total Weight (kg)",
        "targets": [
          {
            "expr": "sum(bag_counter_bags_total{class=\"25kg\"}) * 25 + sum(bag_counter_bags_total{class=\"50kg\"}) * 50",
            "legendFormat": "Weight",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5000},
                {"color": "orange", "value": 10000}
              ]
            },
            "unit": "kg"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "type": "stat",
        "title": "WebSocket Clients",
        "targets": [
          {
            "expr": "bag_counter_websocket_clients",
            "legendFormat": "Clients",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "type": "stat",
        "title": "Detection Errors (5m)",
        "targets": [
          {
            "expr": "sum(rate(bag_counter_detection_errors_total[5m]))",
            "legendFormat": "Errors/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.1},
                {"color": "red", "value": 0.5}
              ]
            },
            "unit": "eps"
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "type": "piechart",
        "title": "Bags by Class",
        "targets": [
          {
            "expr": "sum by (class) (bag_counter_bags_total)",
            "legendFormat": "{{class}}",
            "refId": "A"
          }
        ],
        "options": {
          "pieType": "pie",
          "displayLabels": ["name", "value", "percent"]
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "type": "timeseries",
        "title": "Processing Time (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(bag_counter_processing_time_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(bag_counter_processing_time_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "type": "timeseries",
        "title": "System Resources",
        "targets": [
          {
            "expr": "bag_counter_cpu_usage_percent",
            "legendFormat": "CPU %",
            "refId": "A"
          },
          {
            "expr": "bag_counter_memory_usage_bytes / 1024 / 1024",
            "legendFormat": "Memory MB",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "type": "timeseries",
        "title": "API Latency (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(bag_counter_api_latency_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        }
      },
      {
        "id": 9,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
        "type": "table",
        "title": "Bags Counted by Class and Wagon",
        "targets": [
          {
            "expr": "sum by (class, wagon_id) (bag_counter_bags_total)",
            "legendFormat": "{{class}} - {{wagon_id}}",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "class": "Class",
                "wagon_id": "Wagon ID",
                "Value": "Count"
              }
            }
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
